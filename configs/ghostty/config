# --------- Config ---------
# ==========================
# --- Window Settings ---
window-width = 146
window-height = 34
window-padding-x = 2
window-padding-y = 2

resize-overlay = always
resize-overlay-position = top-left
window-new-tab-position = end
window-padding-balance = true
window-step-resize = true
window-save-state = always
window-theme = ghostty
window-decoration = server

# --- Transparency and Blur ---
background-opacity = 0.85
background-blur = 40

# --- Colors & Theme ---
background = #000000
foreground = #dddddd
selection-background = #b5d5ff
selection-foreground = #000000
bold-color = bright

# Black
palette = 0=#000000
palette = 8=#767676
# Red
palette = 1=#cc0403
palette = 9=#f2201f
# Green
palette = 2=#19cb00
palette = 10=#23fd00
# Yellow
palette = 3=#cecb00
palette = 11=#fffd00
# Blue
palette = 4=#0d73cc
palette = 12=#1a8fcf
# Magenta
palette = 5=#cb1ed1
palette = 13=#fd28ff
# Cyan
palette = 6=#0dcdcd
palette = 14=#14ffff
# White
palette = 7=#dddddd
palette = 15=#ffffff

# --- Font ---
font-family = "MesloLGS NF"
font-size = 12

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow

# --- Cursor & Mouse ---
cursor-style = underline
mouse-hide-while-typing = true

# Cursor Trail Animation
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always

# --- Keybindings ---
# Copy/Paste Binds
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Tabs Binds
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+w=close_tab
keybind = super+w=close_window

# Split Binds
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down

# Font Size Binds
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# --- Typography Tweaks ---
# Adds breathing room between lines
adjust-cell-height = 5%
font-feature = +calt,+liga

# --- Updates ---
auto-update = download
auto-update-channel = stable

# Custom shaders
# https://github.com/hackrmomo/ghostty-shaders
# https://github.com/KroneCorylus/shader-playground
# https://github.com/sahaj-b/ghostty-cursor-shaders
